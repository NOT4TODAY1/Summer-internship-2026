# ============================================
# RAG Enterprise Assistant - Environment Config
# Copy this file to ".env" and adjust as needed
# ============================================

# --- LLM backend (Ollama - local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral          # options: mistral, llama3, llama3.1, etc.
OLLAMA_TEMPERATURE=0.1
# Use CPU when Ollama's CUDA backend is unavailable or crashes.
OLLAMA_NUM_GPU=0

# --- Embeddings (local, no API key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (ChromaDB, persisted locally) ---
CHROMA_PERSIST_DIR=./data/processed/chroma_db
CHROMA_COLLECTION_NAME=company_documents

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- MLflow tracking (optional, local by default) ---
MLFLOW_TRACKING_URI=./mlruns
